# ==============================================
# AGROSTECH — .gitignore
# ==============================================

# ⚠️  NEVER COMMIT API KEYS OR SECRETS
integrations/keys.txt
*.env
.env.*
secrets.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.eggs/

# Node (if frontend added later)
node_modules/
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Runtime databases (dados de clientes/deals — não versionar)
runner/*.db

# Geomart / Google Sheets — sessão e credenciais de serviço
runner/geomart_storage_state.json
runner/*service-account*.json
runner/*credentials*.json

# Temp files
~$*
*.tmp
*.bak
runner/tmp_*.py

# Rasters MapBiomas (arquivos grandes, dados geo — não versionar)
runner/data/mapbiomas/*.tif
runner/data/mapbiomas/*.tiff

# Dados de clientes — não versionar (repo público)
Carteiras de clientes/
Propostas Commercias/

# Conteúdo gerado por lead (Raio-X/drip nomeiam fazenda real — mesma regra acima)
data/generated/raiox/
data/generated/pre_call_drip_*.md

# Captura de eventos (/event no Telegram) — dados reais de lead capturados em campo
# (ao reusar event_capture.py num próximo evento, adicionar a nova pasta aqui)
runner/data/AvAg2026/
