# ==============================================
# AGROSTECH — .gitignore
# ==============================================

# ⚠️  NEVER COMMIT API KEYS OR SECRETS
integrations/keys.txt
*.env
.env.*
secrets.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.eggs/

# Node (if frontend added later)
node_modules/
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Runtime databases (dados de clientes/deals — não versionar)
runner/*.db

# Temp files
~$*
*.tmp
*.bak
