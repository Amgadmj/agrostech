# AgrosTech SaaS Platform — Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.

# -----------------------------------------------------------------------------
# Supabase PostGIS Infrastructure
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Geospatial Basemaps & 3D Globe
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# Optional: Cesium Ion Token for photogrammetry / WorldTerrain streaming
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# -----------------------------------------------------------------------------
# Requirement R1: Registro Rural CAR API (SICAR Demonstrativo & R2C Compliance)
# -----------------------------------------------------------------------------
# Official API key from https://registrorural.com.br (Required for live CAR enrichment)
REGISTRO_RURAL_API_KEY=your-registro-rural-api-key
# Base URL for Registro Rural Gateway v2 (Default: https://api-gateway-v2.registrorural.com.br)
REGISTRO_RURAL_API_URL=https://api-gateway-v2.registrorural.com.br

# -----------------------------------------------------------------------------
# Requirement R2: INPE Brazil Data Cube (BDC) STAC API — Sentinel-1 RTC L2 ARD
# -----------------------------------------------------------------------------
# BDC STAC API root endpoint for Sentinel-1 RTC collection
BDC_STAC_URL=https://data.inpe.br/bdc/stac/v1
# Personal Access Token for Brazil Data Cube (BDC) STAC API
BDC_ACCESS_TOKEN=your-bdc-access-token

# -----------------------------------------------------------------------------
# Requirement R2: Commercial Sub-Meter SAR Tasking Adapters
# -----------------------------------------------------------------------------
# Umbra Space Canopy API key for 0.25m - 1.0m X-band spotlight SAR tasking
UMBRA_API_KEY=your-umbra-canopy-api-key
# Airbus Defence and Space TerraSAR-X tasking API credential
TERRASARX_API_KEY=your-terrasarx-api-key

# -----------------------------------------------------------------------------
# System Runtime & Integrity Modes
# -----------------------------------------------------------------------------
# Demo Mode Flag (Required for demo cookie bypass and demo badge rendering)
# Set to "true" in demo / audit testing. Set to "false" in real production with real Supabase Auth.
NEXT_PUBLIC_DEMO_MODE=true

# Mode: "production" (strict live validation) or "demo" (with deterministic fallback)
INTEGRITY_MODE=demo

# Allow graceful fallback to certified reference fixtures if external APIs time out
ALLOW_MOCK_FALLBACK=true
